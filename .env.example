# Copy this file to .env and fill in your own credentials.
# Never commit the values from your Razorpay dashboard.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Optional: enables the Gemini-powered chat agent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional base URL used by buyer-agent.js.
CARTWISE_URL=http://127.0.0.1:8000
BUYER_AGENT_ID=cartwise-demo-buyer-001

# Set true only for offline demos/tests; real Razorpay test orders are skipped.
CARTWISE_DEMO_MODE=false
