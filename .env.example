# Copy this file to .env and fill in your own credentials.
# Never commit the values from your Razorpay dashboard.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Optional: enables the Gemini-powered chat agent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional base URL used by buyer-agent.js.
CARTWISE_URL=http://127.0.0.1:8000
BUYER_AGENT_ID=cartwise-demo-buyer-001

# Firebase Web App configuration (enable Email/Password Authentication).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Set true only for offline demos/tests; real Razorpay test orders are skipped.
CARTWISE_DEMO_MODE=false
